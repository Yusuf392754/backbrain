*.iws

# Generated platform folders — regenerated by `flutter create`, don't need
# to be hand-edited or reviewed, and bloat the repo. If you want CI/CD or
# judges to build without running `flutter create` first, remove these
# lines and commit android/ and ios/ for real.
/android/
/ios/
/macos/
/windows/
/linux/
/web/

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# --- secrets: never commit these ---
# All keys in this project are meant to be passed via --dart-define at
# build time (see README), never hardcoded — but .env-style files are
# blocked here too as a backstop in case anyone adds one later.
*.env
.env.*
**/google-services.json
**/GoogleService-Info.plist
